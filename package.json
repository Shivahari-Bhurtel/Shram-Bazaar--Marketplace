{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bash ./run-local.sh",
    "dev:vite": "vite",
    "test:auth-navigation": "node --test scripts/test-auth-navigation.mjs",
    "test:worker-dashboard": "node --test scripts/test-worker-dashboard.mjs",
    "test:job-discovery": "node --test scripts/test-job-discovery.mjs",
    "test:ai-status": "node --test scripts/test-ai-status.mjs",
    "validate:jobs": "python3 scripts/validate-jobs.py",
    "ai": "python -m uvicorn main:app --app-dir ai-service --reload --host 0.0.0.0 --port 8000",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lottie-web": "^5.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
