# Text chat uses local Ollama by default. These settings are server-side only.
AI_PROVIDER=ollama
SHRAM_API_BASE_URL=http://127.0.0.1:8080
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_CONNECT_TIMEOUT_SECONDS=2
OLLAMA_TIMEOUT_SECONDS=45
OLLAMA_KEEP_ALIVE=2h
OLLAMA_STARTUP_TIMEOUT_SECONDS=20
OLLAMA_START_COOLDOWN_SECONDS=30
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=300

# Optional Gemini fallback for text chat and existing voice features. Resume extraction uses local Ollama.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_VOICE_API_KEY=replace-with-your-gemini-voice-api-key
CORS_ORIGINS=http://localhost:8444,http://127.0.0.1:8444,http://localhost:8443,http://127.0.0.1:8443
